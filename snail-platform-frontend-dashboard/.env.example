# 天地图浏览器端密钥（必填）
# 申请地址：https://console.tianditu.gov.cn/api/key
# 注册/登录 → 控制台 → 应用管理 → 创建新应用 → 应用类型选「浏览器端」
VITE_TIANDITU_KEY=Please apply for your own key at the Tianditu Open Platform and replace this placeholder

# 地图初始中心点（必填，十进制度；高度单位米，可省略，默认 200000）
# 示例为成都（天府广场）
VITE_MAP_CENTER_LON=104.065735
VITE_MAP_CENTER_LAT=30.659462
VITE_MAP_CENTER_HEIGHT=200000

# 3D 模型入口（可省略，默认 /3dtiles/tileset.json）
# 换地标时：新模型转 3D Tiles 后放到 public 下新目录，改此变量指向新 tileset.json
VITE_MODEL_URL=/3dtiles/tileset.json

# 3D 模型固定机位（可省略；五个值全部配置时生效，否则按模型包围盒自动取景）
# 开启「3D 模型」开关时相机飞到该机位。heading: 0=正北 90=东 180=南 270=西；
# pitch: 0=平视，负值向下俯视。示例为成都双子塔（塔对中心 104.062303,30.584961，
# 塔高 218m；机位在塔正西约 420m、高 200m，从西向东看双塔）
VITE_MODEL_VIEW_LON=104.057921
VITE_MODEL_VIEW_LAT=30.584961
VITE_MODEL_VIEW_HEIGHT=200
VITE_MODEL_VIEW_HEADING=90
VITE_MODEL_VIEW_PITCH=-12
