<?xml version="1.0" encoding="UTF-8"?>
<!--
  snail-platform-backend：后端线聚合根。
  职责：版本单点、依赖聚合、护栏基线；<modules> 只登记 framework / function / start，
  管理端线不进 reactor。子模块一律不写 <version>。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.snail.platform</groupId>
    <artifactId>snail-platform-backend</artifactId>
    <version>0.0.1</version>
    <packaging>pom</packaging>

    <name>snail-platform-backend</name>
    <description>Snail Platform 后端：技术基建层 + 业务模块层 + 唯一装配入口</description>

    <modules>
        <module>snail-platform-framework</module>
        <module>snail-platform-function</module>
        <module>snail-platform-start</module>
    </modules>

    <properties>
        <!-- 编译 17 语言级别、构建运行 JDK 21；产物 class major version = 61 -->
        <java.version>17</java.version>

        <!-- BOM 未托管的构件版本单点 -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <springdoc.version>3.1.1</springdoc.version>
        <swagger-annotations.version>2.2.55</swagger-annotations.version>
        <!-- swagger-core 2.2.55 按 Jackson 2.22.1 构建,Boot BOM 的 2.21.5 触发 enforcer 上界规则;
             Jackson 2 全项目只以传递依赖存在(enforcer 禁直引),抬到 2.22.1 与 swagger 对齐 -->
        <jackson-2-bom.version>2.22.1</jackson-2-bom.version>
        <fastexcel.version>1.3.0</fastexcel.version>
        <archunit.version>1.5.1</archunit.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <nimbus-jose-jwt.version>10.9.1</nimbus-jose-jwt.version>
        <hutool.version>5.8.38</hutool.version>
        <!-- SFTP 客户端: mwiede 维护分支,com.jcraft 原版已停更 -->
        <jsch.version>0.2.21</jsch.version>
        <!-- AWS SDK v2: S3 协议兼容存储(MinIO/云 OSS)走同一套协议栈,BOM 单点锁版本 -->
        <awssdk-bom.version>2.25.60</awssdk-bom.version>
        <!-- 内嵌 SFTP 服务器:仅流程测试用,验证 storage 流程不再依赖外部 SFTP -->
        <sshd.version>2.12.1</sshd.version>

        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部构件：子模块互引时不写版本 -->
            <dependency>
                <groupId>com.snail.platform</groupId>
                <artifactId>snail-framework-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.snail.platform</groupId>
                <artifactId>snail-framework-db</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.snail.platform</groupId>
                <artifactId>snail-framework-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.snail.platform</groupId>
                <artifactId>snail-framework-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.snail.platform</groupId>
                <artifactId>snail-framework-log</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.snail.platform</groupId>
                <artifactId>snail-framework-excel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.snail.platform</groupId>
                <artifactId>snail-function-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.snail.platform</groupId>
                <artifactId>snail-function-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.snail.platform</groupId>
                <artifactId>snail-function-notify</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.snail.platform</groupId>
                <artifactId>snail-framework-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 端口层测试夹具随 test-jar 发布,start 的流程测试复用,避免夹具源码跨模块复制 -->
            <dependency>
                <groupId>com.snail.platform</groupId>
                <artifactId>snail-framework-storage</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.snail.platform</groupId>
                <artifactId>snail-function-storage</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 对象存储客户端单一收敛：JSch 只在 framework-storage 内使用 -->
            <dependency>
                <groupId>com.github.mwiede</groupId>
                <artifactId>jsch</artifactId>
                <version>${jsch.version}</version>
            </dependency>
            <!-- S3 协议栈版本由 BOM 单点,业务模块引 s3 不写版本;HTTP 客户端收敛 url-connection -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 内嵌 SFTP 服务器:仅 start 的流程测试引入,不进主依赖树 -->
            <dependency>
                <groupId>org.apache.sshd</groupId>
                <artifactId>sshd-core</artifactId>
                <version>${sshd.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.sshd</groupId>
                <artifactId>sshd-sftp</artifactId>
                <version>${sshd.version}</version>
            </dependency>

            <!-- ORM：boot4 starter 线，方言在 snail-framework-db 固定为 MYSQL -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- 接口文档：只引引擎一次，业务模块不重复声明 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger-annotations.version}</version>
            </dependency>

            <!-- 表格文件 -->
            <dependency>
                <groupId>cn.idev.excel</groupId>
                <artifactId>fastexcel</artifactId>
                <version>${fastexcel.version}</version>
            </dependency>

            <!-- 映射：编译期生成，只用于 PO 与契约对象间的 1:1 对位拷贝 -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- JWT 实现单一收敛在 Nimbus -->
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus-jose-jwt.version}</version>
            </dependency>

            <!-- 通用工具单一收敛在 Hutool：验证码、BCrypt、日期、字符串等均用它，不自研 util -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- 边界护栏 -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 全 reactor 共享:POJO 样板收敛在 Lombok,编译期生成,产物不带 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <!-- Lombok 与 MapStruct 并存时顺序固定为 lombok → binding → processor -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-platform-baseline</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>构建运行 JDK 必须 ≥ 21；语言级别仍由 java.version=17 锁定</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <!-- 平台不直接引 Jackson 2：Boot 4 用 tools.jackson，只允许出现在传递依赖上 -->
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>com.fasterxml.jackson*:*</exclude>
                                    </excludes>
                                </bannedDependencies>
                                <requireUpperBoundDeps/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
