<?xml version="1.0" encoding="UTF-8"?>
<!--
  snail-platform-start：唯一装配点。
  只依赖业务模块（system + auth），framework 构件由传递依赖带入；ArchUnit 与冒烟测试住在这里。
  spring-boot-maven-plugin 只在此声明，repackage 出可执行 jar。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.snail.platform</groupId>
        <artifactId>snail-platform-backend</artifactId>
        <version>0.0.1</version>
    </parent>

    <artifactId>snail-platform-start</artifactId>
    <packaging>jar</packaging>
    <name>snail-platform-start</name>

    <dependencies>
        <dependency>
            <groupId>com.snail.platform</groupId>
            <artifactId>snail-function-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.snail.platform</groupId>
            <artifactId>snail-function-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.snail.platform</groupId>
            <artifactId>snail-function-notify</artifactId>
        </dependency>
        <dependency>
            <groupId>com.snail.platform</groupId>
            <artifactId>snail-function-storage</artifactId>
        </dependency>
        <!-- 流程中心:引擎接入层 framework-workflow 由它传递带入,start 不再直引(方案 §2 边界) -->
        <dependency>
            <groupId>com.snail.platform</groupId>
            <artifactId>snail-function-workflow</artifactId>
        </dependency>
        <!-- 存储端口层的内嵌 SFTP 测试夹具:仅测试期使用,不进入运行时依赖树 -->
        <dependency>
            <groupId>com.snail.platform</groupId>
            <artifactId>snail-framework-storage</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- 接口文档：springdoc 3.x 对应 Boot 4；api-docs 与 swagger-ui 路径的放行已在 framework-security 白名单 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 把 Web 测试切片拆到独立构件,AutoConfigureMockMvc 在此 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 内嵌 SFTP 服务器:文件存储流程测试用,替代外部 SFTP 依赖 -->
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-sftp</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>snail-platform</finalName>
        <resources>
            <!-- 与默认资源目录同路径，唯一差别：目录占位文件不进 jar -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/.gitkeep</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- 版本与 repackage 执行由 starter-parent 的 pluginManagement 提供；
                 主类唯一，交给插件自动探测，不在 POM 里重复点名 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
