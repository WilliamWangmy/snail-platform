<?xml version="1.0" encoding="UTF-8"?>
<!--
  snail-function-external:第三方接口网关——平台所有第三方调用的唯一出口(厂商适配/配置/留痕一处管完)。
  每次调用经 AbstractExternalClient 模板方法异步落账 sys_external_call_log;
  第三方 SDK 依赖只准住本模块(ArchUnit 机械执法),消费方只准 import external.api 包。
  依赖仅 framework 三件,零依赖其他 function 模块——所有模块都可能成为消费方,依赖图无环。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.snail.platform</groupId>
        <artifactId>snail-platform-function</artifactId>
        <version>0.0.1</version>
    </parent>

    <artifactId>snail-function-external</artifactId>
    <name>snail-function-external</name>

    <dependencies>
        <dependency>
            <groupId>com.snail.platform</groupId>
            <artifactId>snail-framework-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.snail.platform</groupId>
            <artifactId>snail-framework-db</artifactId>
        </dependency>
        <!-- 复用操作日志切面的脱敏单点,不另起一套敏感字段名单 -->
        <dependency>
            <groupId>com.snail.platform</groupId>
            <artifactId>snail-framework-log</artifactId>
        </dependency>
        <!-- 流水查询端点的 @PreAuthorize 权限注解 -->
        <dependency>
            <groupId>com.snail.platform</groupId>
            <artifactId>snail-framework-security</artifactId>
        </dependency>
        <!-- 邮件厂商适配;未配置 spring.mail 时 JavaMailSender 不装配,MailPort.available()=false 自动降级 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
    </dependencies>
</project>
