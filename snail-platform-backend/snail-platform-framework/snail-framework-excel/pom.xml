<?xml version="1.0" encoding="UTF-8"?>
<!--
  snail-framework-excel：fastexcel 的读写单点——导出经 ExcelExporter 行数据写 xlsx 直接挂 HTTP 响应，
  导入经 ExcelImporter 把上传的表格流按 @ExcelProperty 头类读成行 Bean；业务侧只许碰这两个出口。
  不认识业务 DTO，导入行数上限由调用方按业务口径传入。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.snail.platform</groupId>
        <artifactId>snail-platform-framework</artifactId>
        <version>0.0.1</version>
    </parent>

    <artifactId>snail-framework-excel</artifactId>
    <name>snail-framework-excel</name>

    <dependencies>
        <dependency>
            <groupId>com.snail.platform</groupId>
            <artifactId>snail-framework-core</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.idev.excel</groupId>
            <artifactId>fastexcel</artifactId>
        </dependency>
    </dependencies>
</project>
