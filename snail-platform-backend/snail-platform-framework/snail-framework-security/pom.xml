<?xml version="1.0" encoding="UTF-8"?>
<!--
  snail-framework-security：令牌签发与校验、口令散列、认证主体与权限码判定入口。
  不查账户表，不判断「账户是否存在」这类业务事实；与 Web 无关，非 HTTP 协议层可复用同一套语义。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.snail.platform</groupId>
        <artifactId>snail-platform-framework</artifactId>
        <version>0.0.1</version>
    </parent>

    <artifactId>snail-framework-security</artifactId>
    <name>snail-framework-security</name>

    <dependencies>
        <dependency>
            <groupId>com.snail.platform</groupId>
            <artifactId>snail-framework-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- 签发/校验收敛到单一 JWT 实现；Boot BOM 未托管该坐标，版本在父 POM 单点 -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
        </dependency>
    </dependencies>
</project>
