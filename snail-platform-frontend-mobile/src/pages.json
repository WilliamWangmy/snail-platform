{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "Snail 工作台"
      }
    },
    {
      "path": "pages/login/login",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/messages/messages",
      "style": {
        "navigationBarTitleText": "消息",
        "enablePullDownRefresh": true,
        "backgroundColor": "#f4f5f7"
      }
    },
    {
      "path": "pages/profile/profile",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/profile/change-password",
      "style": {
        "navigationBarTitleText": "修改密码"
      }
    }
  ],
  "tabBar": {
    "color": "#888780",
    "selectedColor": "#1D9E75",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "工作台",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-selected.png"
      },
      {
        "pagePath": "pages/messages/messages",
        "text": "消息",
        "iconPath": "static/tabbar/chat.png",
        "selectedIconPath": "static/tabbar/chat-selected.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "static/tabbar/my.png",
        "selectedIconPath": "static/tabbar/my-selected.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "Snail 蜗牛平台",
    "navigationBarBackgroundColor": "#1D9E75",
    "backgroundColor": "#F4F5F7"
  }
}
